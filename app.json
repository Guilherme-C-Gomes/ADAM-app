{
  "expo": {
    "name": "ADAM",
    "slug": "adam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "adam",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "br.ong.adam.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.ong.adam.app",
      "adaptiveIcon": {
        "backgroundColor": "#9E05D2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O ADAM usa as suas fotos para colocar a foto do seu perfil, a foto da criança na ficha e os documentos entregues.",
          "cameraPermission": "O ADAM usa a câmera para tirar a foto do seu perfil, a foto da criança na ficha e fotografar os documentos entregues.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0A0A12",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ab11c914-beab-4d88-b530-ab75ae9f5465"
      }
    },
    "owner": "tay4ang",
    "updates": {
      "url": "https://u.expo.dev/ab11c914-beab-4d88-b530-ab75ae9f5465"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
