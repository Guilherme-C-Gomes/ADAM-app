# Supabase do ADAM > botao Connect (ou Project Settings > API Keys).
# O projeto e SO do ADAM, na conta da ONG: nada de chaves de outro projeto.
# A publishable key e publica por design: o acesso real e controlado por
# Row Level Security no banco. Nunca coloque a secret key (sb_secret_...) aqui.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_SUA_CHAVE
