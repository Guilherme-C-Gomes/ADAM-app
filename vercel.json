{
  "buildCommand": "expo export -p web",
  "outputDirectory": "dist",
  "devCommand": "expo",
  "cleanUrls": true,
  "framework": null,
  "functions": {
    "api/backup.ts": {
      "maxDuration": 60
    },
    "api/inscricao/enviar.ts": {
      "maxDuration": 30
    },
    "api/inscricao/ficha.ts": {
      "maxDuration": 15
    }
  },
  "crons": [
    { "path": "/api/backup?vez=diaria", "schedule": "0 15 * * *" },
    { "path": "/api/backup?vez=semanal", "schedule": "0 11 * * 5" },
    { "path": "/api/backup?vez=mensal", "schedule": "0 11 1 * *" }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
